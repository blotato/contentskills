    "times": { "type": "text", "level": 1, "order": 1, "default": "0, 3, 6", "label": "Appear at (seconds, comma separated)", "maxLength": 120 },
    "accent": { "type": "color", "level": 2, "order": 0, "default": "#e6ff3d", "label": "Newest item color (highlighter)" },
